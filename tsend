#!/bin/bash

[[ -z ${debug_mode} ]] || set -x

_logfile="/tmp/tsend.$$"
_botfile="${HOME}/.tsendrc"
declare -a _tbot_params

[[ -f ${_botfile} ]] && source ${_botfile} || true

function _die(){
	echo "[error]: $@" >&2
	rm -f ${_logfile}
	exit 1
}

function _help(){
echo "Usage: $(basename $0) [options] [\"text\"]

Options:
	-h|--help			- show this help
	-K|--token <token>		- specify <token> of telegram bot
	-C|--chat_id <chat_id>		- unique identifier for the target
					  chat or username of the target
					  channel (in the format @channelusername)
	-d|--document <file>		- send document <file>
	-a|--audio <file>		- send audio file <file>
	-P|--performer <text>		- specify performer for audio file
	-T|--title <text>		- specify title for audio file
	-p|--photo <file>		- send photo <file>
	-v|--video <file>		- send video <file>
	-W|--width <width>		- specify video width
	-H|--height <height>		- specify video height
	-dn|--disable-notification	- sends the message silently. Users will
					  receive a notification with no sound.
	-pc|--protect-content		- protects the contents of the sent message
					  from forwarding and saving
"
}

function _setfile(){
	[[ -n "$1" && -z "${_file_type}" ]] || _die "you can only send one type of file"
	[[ -n "$2" ]] || _die "you must specify the file to send"
	[[ -f "$2" ]] || _die "file <$2> is not exist"
	_file_type="$1"
	_file="$2"
	case "${_file_type}" in
		document)	_tbot_command="sendDocument"	;;
		audio)		_tbot_command="sendAudio"	;;
		video)		_tbot_command="sendVideo"	;;
		photo)		_tbot_command="sendPhoto"	;;
		*)		_die "Unknown type of file"	;;
	esac
}

while (($#)) ; do
	case "$1" in
		-h|--help)
			_help
			exit
		;;
		-K|--token)
			TBOT_TOKEN="$1"
			shift
		;;
		-C|--chat_id)
			TBOT_CHAT_ID="$1"
			shift
		;;
		-d|--document)
			shift
			_setfile document "$1"
			shift
		;;
		-a|--audio)
			shift
			_setfile audio "$1"
			shift
		;;
		-P|--performer)
			[[ ${_file_type} == "audio" ]] || _die "use $1 for send audio file only!"
			shift
			_tbot_params+=( performer="$1" )
			shift
		;;
		-T|--title)
			[[ ${_file_type} == "audio" ]] || _die "use $1 for send audio file only!"
			shift
			_tbot_params+=( title="$1" )
			shift
		;;
		-p|--photo)
			shift
			_setfile photo "$1"
			shift
		;;
		-v|--video)
			shift
			_setfile video "$1"
			shift
		;;
		-W|--width)
			[[ ${_file_type} == "video" ]] || _die "use $1 for send video file only!"
			shift
			_tbot_params+=( width="$1" )
			shift
		;;
		-H|--height)
			[[ ${_file_type} == "video" ]] || _die "use $1 for send video file only!"
			shift
			_tbot_params+=( height="$1" )
			shift
		;;
		-dn|--disable-notification)
			_tbot_params+=( disable_notification=true )
			shift
		;;
		-pc|--protect-content)
			_tbot_params+=( protect_content=true )
			shift
		;;
		-t|--thumb)
			shift
			[[ -f "$1" ]] || _die "file <$1> is not exist"
			_thumb="$1"
			shift
		;;
		*)
			if [[ -n "${_tbot_command}" ]] ; then
				_tbot_params+=( "caption=$1" )
			else
				_tbot_params+=( "text=$1" )
			fi
			shift
		;;
	esac
done

[[ -n "${TBOT_TOKEN}" ]] || _die "token is empty. Please use \"-t <token>\" or set TBOT_TOKEN=<token> in ~/.tsendrc"
[[ -n "${TBOT_CHAT_ID}" ]] || _die "chat_id is empty. Please use \"-c <chat_id>\" or set TBOT_CHAT_ID=<chat_id> in ~/.tsendrc"

_url_header="https://api.telegram.org/bot${TBOT_TOKEN}/"

_tbot_params+=( chat_id=${TBOT_CHAT_ID} )

export IFS='&'
curl \
	${_file:+-F${_file_type:-document}=@${_file}} \
	${_thumb:+-Fthumb=@${_thumb}} \
	"${_url_header}${_tbot_command:-sendMessage}?${_tbot_params[*]}" \
	2>/dev/null \
	1>${_logfile}
unset IFS

if [[ $(jq -r .ok ${_logfile}) == false ]] ; then
	_err="$(jq -r .description ${_logfile})"
	_die "bot return message: ${_err}"
fi
