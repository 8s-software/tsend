#!/bin/bash

[[ -z ${debug_mode} ]] || set -x

_logfile="/tmp/tsend.$$"
_botfile="${HOME}/.tsendrc"
declare -a _tbot_params

[[ -f ${_botfile} ]] && source ${_botfile} || true

function _die(){
	echo "[error]: $@" >&2
	rm -f ${_logfile}
	exit 1
}

function _help(){
echo "Usage: $(basename $0) [options] ["some text"]

Options:
	-h|--help			- show this help
	-T|--token <token>		- specify <token> of telegram bot
	-C|--chat_id <chat_id>		- Unique identifier for the target chat or username of the target channel (in the format @channelusername)
	-f|--file <file>		- send <file>
	-a|--audio			- mark <file> as audio file
	-P|--performer <text>		- specify performer for audio file
	-n|--title <text>		- specify title for audio file
	-F|--photo			- mark <file> as photo
	-V|--video			- mask <file> as video file
	-w|--width <width>		- specify video width
	-H|--height <height>		- specify video height
	-d|--disable-notification	- Sends the message silently. Users will receive a notification with no sound.
	-p|--protect-content		- Protects the contents of the sent message from forwarding and saving
"
}

while (($#)) ; do
	case "$1" in
		-T|--token)
			TBOT_TOKEN="$1"
			shift
		;;
		-C|--chat_id)
			TBOT_CHAT_ID="$1"
			shift
		;;
		-f|--file)
			_tbot_command="sendDocument"
			shift
			[[ -f "$1" ]] || _die "File <$1> is not exist"
			_file="$1"
			shift
		;;
		-a|--audio)
			[[ -z "${_tbot_command}" || ${_tbot_command} == "sendDocument" ]] || _die "The file type is already defined as ${_file_type}"
			_tbot_command="sendAudio"
			_file_type="audio"
			shift
		;;
		-P|--performer)
			[[ ${_file_type} == "audio" ]] || _die "Use $1 for send audio file only!"
			shift
			_tbot_params+=( performer="$1" )
			shift
		;;
		-n|--title)
			[[ ${_file_type} == "audio" ]] || _die "Use $1 for send audio file only!"
			shift
			_tbot_params+=( title="$1" )
			shift
		;;
		-F|--photo)
			[[ -z "${_tbot_command}" || ${_tbot_command} == "sendDocument" ]] || _die "The file type is already defined as ${_file_type}"
			_tbot_command="sendPhoto"
			_file_type="photo"
			shift
		;;
		-V|--video)
			[[ -z "${_tbot_command}" || ${_tbot_command} == "sendDocument" ]] || _die "The file type is already defined as ${_file_type}"
			_tbot_command="sendVideo"
			_file_type="video"
			shift
		;;
		-w|--width)
			[[ ${_file_type} == "video" ]] || _die "Use $1 for send video file only!"
			shift
			_tbot_params+=( width="$1" )
			shift
		;;
		-H|--height)
			[[ ${_file_type} == "video" ]] || _die "Use $1 for send video file only!"
			shift
			_tbot_params+=( height="$1" )
			shift
		;;
		-d|--disable-notification)
			_tbot_params+=( disable_notification=true )
			shift
		;;
		-p|--protect-content)
			_tbot_params+=( protect_content=true )
			shift
		;;
		-t|--thumb)
			shift
			[[ -f "$1" ]] || _die "File <$1> is not exist"
			_thumb="$1"
			shift
		;;
		*)
			if [[ -n "${_tbot_command}" ]] ; then
				_tbot_params+=( "caption=$1" )
			else
				_tbot_params+=( "text=$1" )
			fi
			shift
		;;
	esac
done

[[ -n "${TBOT_TOKEN}" ]] || _die "token is empty. Please use \"-t <token>\" or set TBOT_TOKEN=<token> in ~/.tsendrc"
[[ -n "${TBOT_CHAT_ID}" ]] || _die "chat_id is empty. Please use \"-c <chat_id>\" or set TBOT_CHAT_ID=<chat_id> in ~/.tsendrc"

_url_header="https://api.telegram.org/bot${TBOT_TOKEN}/"

_tbot_params+=( chat_id=${TBOT_CHAT_ID} )

export IFS='&'
curl \
	${_file:+-F${_file_type:-document}=@${_file}} \
	${_thumb:+-Fthumb=@${_thumb}} \
	"${_url_header}${_tbot_command:-sendMessage}?${_tbot_params[*]}" \
	2>/dev/null \
	1>${_logfile}
unset IFS

if [[ $(jq -r .ok ${_logfile}) == false ]] ; then
	_err="$(jq -r .description ${_logfile})"
	_die "bot return message: ${_err}"
fi
